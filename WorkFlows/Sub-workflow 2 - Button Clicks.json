    {
      "parameters": {
        "jsCode": "const inputJson = $('When Executed by Another Workflow').first().json;\n\nif (!inputJson.callback_query || !inputJson.callback_query.data) {\n    throw new Error(\"لم يتم العثور على بيانات الزر في العقدة الأولى.\");\n}\n\n// البيانات القادمة هي مثل \"confirm_261\"\nconst rawData = inputJson.callback_query.data;\n\nconst underscoreIndex = rawData.indexOf('_');\nconst actionName = rawData.substring(0, underscoreIndex); // \"confirm\" أو \"cancel\"\nconst rowId = rawData.substring(underscoreIndex + 1);     // \"261\"\n\n// إخراج البيانات مع تسمية المتغير row_id\nreturn {\n    json: {\n        action: actionName,\n        row_id: rowId\n    }\n};"
      },
