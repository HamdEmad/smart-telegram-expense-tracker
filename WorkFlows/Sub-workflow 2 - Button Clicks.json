        "jsCode": "const inputJson = $('When Executed by Another Workflow').first().json;\n\nif (!inputJson.callback_query || !inputJson.callback_query.data) {\n    throw new Error(\"لم يتم العثور على بيانات الزر في العقدة الأولى.\");\n}\n\n// البيانات القادمة: \"confirm__Expense__exec-id-123\"\nconst rawData = inputJson.callback_query.data;\nconst parts = rawData.split('__');\n\nif (parts.length < 3) {\n    throw new Error(\"صيغة بيانات الزر غير صحيحة: \" + rawData);\n}\n\nconst actionName = parts[0];   // \"confirm\" أو \"cancel\"\nconst recordType = parts[1];   // \"Expense\", \"Gym\", \"Quran\", \"Task\"\nconst rowId = parts[2];        // execution id\n\nreturn {\n    json: {\n        action: actionName,\n        record_type: recordType,\n        row_id: rowId\n    }\n};"
      },
