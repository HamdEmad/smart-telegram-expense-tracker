    {
      "parameters": {
        "jsCode": "const habits = $input.all().map(i => i.json).filter(h => h && h.habit_id);\nconst now = new Date();\nconst todayStr = now.toISOString().split('T')[0];\n\nlet msg = `📅 *لوحة إنجاز اليوم (${todayStr}):*\\n\\n`;\n\nif (habits.length > 0) {\n    msg += `🔥 *عاداتك اليومية:*\\n`;\n    habits.forEach((h, idx) => {\n        const done = (h.last_completed_date === todayStr);\n        const statusIcon = done ? '✅ منجز' : '⏳ متبقي';\n        const streak = h.current_streak ? ` (Streak: ${h.current_streak} 🔥)` : '';\n        msg += `${idx + 1}. ${h.habit_name} — ${statusIcon}${streak}\\n`;\n    });\n} else {\n    msg += `🎯 *لا توجد عادات مسجلة بعد. أرسل مثلاً:*\\n_\"عايز أتعلم إنجليزي ربع ساعة كل يوم\"_\\n`;\n}\n\nmsg += `\\n💡 _لإنجاز عادة أرسل:_ \"خلصت إنجليزي اليوم\"`;\n\nreturn [{\n    json: {\n        chat_id: $('Telegram Trigger').item.json.message.chat.id,\n        dashboard_text: msg\n    }\n}];"
      },
